{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dastyar.local/schemas/topic_flow.schema.json",
  "title": "TopicFlow",
  "description": "اسکیمای مسیر تصمیم موضوعی (assets/brain/topics/*.json). این فایل قرارداد داده است؛ dev/tools/topic_schema.py همین قواعد را بدون وابستگی خارجی پیاده می‌کند تا در CI بدون jsonschema اجرا شود.",
  "type": "object",
  "required": ["live", "gate", "topic", "law", "disclaimer", "clarify", "rules", "leaves"],
  "additionalProperties": true,
  "properties": {
    "live": {"type": "boolean", "description": "فقط موضوع live در گفتگو جواب می‌دهد."},
    "topic": {"type": "string", "minLength": 1},
    "label": {"type": "string"},
    "law": {"type": "string", "minLength": 1, "description": "شناسهٔ قانون در assets/laws/_meta.json"},
    "gate": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "disclaimer": {"type": "string", "minLength": 1},
    "clarify": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["leaf"],
        "additionalProperties": true,
        "properties": {
          "leaf": {"type": "string", "minLength": 1},
          "any": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "all_groups": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "string"}}}
        }
      }
    },
    "leaves": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["title", "text", "articles"],
        "additionalProperties": true,
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "articles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["law", "title"],
              "additionalProperties": true,
              "properties": {
                "law": {"type": "string", "minLength": 1},
                "title": {"type": "string", "pattern": "^(ماده|اصل)\\s+"}
              }
            }
          }
        }
      }
    }
  }
}
